node_modules
dist
*.local
.DS_Store
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# server build outputs (Stage 10)
server/bin
server/obj
server/publish
server/data
*.db
# SQLite WAL sidecars — `*.db` alone left these two untracked after any local
# run, and a local run from the repo root (the documented verification path)
# creates them beside the database it ignores
*.db-shm
*.db-wal
server/wwwroot/

# appliance — local secrets and the model payload (shipped alongside, never committed)
appliance/.env
appliance/models/*.gguf
# Backup & DR (the hard go-live gate): the encryption key and the backup
# files are hospital data / the second-most-important secret after the
# patients — they live on the host, NEVER in the repo or a Docker layer.
appliance/secrets/
appliance/backups/
.local-ca.crt

# installer build artifacts + the per-hospital install-password ledger
# (the ledger holds real hospital secrets - transcribe to the sealed
# envelopes and the vendor record, then delete; NEVER commit)
installer/payload/
installer/Output/
installer/hospitals.csv
